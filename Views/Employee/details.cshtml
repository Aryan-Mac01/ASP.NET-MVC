@model WebApplication3.Models.Employee

@{
ViewBag.Title = "Emp Details";
}

<h2>Emp Details</h2>

<table style="font-family: Arial">
    <tr>
        <td>
            <b>Employee Id: </b>
        </td>
        <td>
            @Model.EmployeeId
        </td>
    </tr>
    <tr>
        <td>
            <b>Name: </b>
        </td>
        <td>
            @Model.Name
        </td>
    </tr>
    <tr>
        <td>
            <b>Gender: </b>
        </td>
        <td>
            @Model.Gender
        </td>
    </tr>
</table>